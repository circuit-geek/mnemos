# Postgres from `docker compose up -d postgres neo4j` (backend/docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://mnemos:mnemos@localhost:5432/mnemos

# Uploaded videos are stored on local disk
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=data/uploads
MAX_UPLOAD_BYTES=524288000

# Neo4j holds the temporal knowledge graph. Required for memory, graph and `ask`.
# NEO4J_PASSWORD is also used by docker compose to create the database; keep them equal.
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=mnemos_dev_password

# `script` runs real SAM through the Meta API (needs META_API_KEY).
# `mock` replays saved fixture output for any video, to try the app without SAM.
SAM_BACKEND=script
# Only used if automatic object discovery finds nothing.
SAM_CONCEPT=object

# Meta Model API key: SAM 3.1 and Muse Spark. Never commit this.
META_API_KEY=
MUSE_MODEL=muse-spark-1.3

# What to track is chosen per video (the upload's `concepts` field, else discovered by Muse Spark).
SAM_MAX_CONCEPTS=5
SAM_DISCOVERY_FRAMES=6
SCENE_SAMPLE_INTERVAL_MS=2000
SCENE_MIN_CONFIDENCE=0.6

# Origins allowed to call the API from a browser (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
